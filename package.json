{
  "name": "flight-select",
  "version": "0.1.0",
  "description": "Geographic review and export of drone imagery.",
  "author": "Flight Select",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable",
    "build:installer": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.flightselect.app",
    "productName": "Flight Select",
    "directories": { "output": "release" },
    "files": ["electron/**/*", "dist/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
